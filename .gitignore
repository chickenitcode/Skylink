# ==============================================================================
# GASCOLAE SKYLINK - GIT IGNORE CONFIGURATION
# Cross-Platform: Windows (PowerShell) & Ubuntu / Linux (Bash)
# Monorepo: NestJS API (Thành viên B) + Expo Mobile (Thành viên A) + AI Pipeline (Thành viên C)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DEPENDENCIES & PACKAGE MANAGERS
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
.npm/
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Package manager lockfile debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 2. BUILD ARTIFACTS & COMPILATION CACHES
# ------------------------------------------------------------------------------
dist/
build/
out/
.turbo/
.cache/
*.tsbuildinfo
.eslintcache

# NestJS build
apps/api/dist/

# ------------------------------------------------------------------------------
# 3. MOBILE CLIENT (EXPO / REACT NATIVE - THÀNH VIÊN A)
# ------------------------------------------------------------------------------
.expo/
.expo-shared/
web-build/
.metro/
metro-cache/

# Native Android / iOS builds (khi chạy npx expo prebuild / bare workflow)
apps/mobile/android/
apps/mobile/ios/
.gradle/
*.apk
*.aab
*.ipa
*.app

# Khóa ký số & chứng chỉ di động (BẢO MẬT TUYỆT ĐỐI)
*.keystore
*.jks
*.p12
*.p8
*.mobileprovision
*.key

# ------------------------------------------------------------------------------
# 4. BACKEND, DATABASE & DOCKER (THÀNH VIÊN B)
# ------------------------------------------------------------------------------
# Dữ liệu volume PostgreSQL chạy qua Docker
postgres-data/
pgdata/
data/postgres/
*.sqlite
*.sqlite3
*.db

# Document Pipeline (Worker LibreOffice / docxtemplater)
~$*
temp_docx/
temp_pdf/
*.tmp

# ------------------------------------------------------------------------------
# 5. BIẾN MÔI TRƯỜNG & KHÓA BẢO MẬT (SECRETS & CREDENTIALS)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
.env.test

# Giữ lại tệp mẫu cấu hình cho cả nhóm
!*.env.example
!.env.template

# ------------------------------------------------------------------------------
# 6. NHẬT KÝ & KIỂM THỬ (LOGS & COVERAGE)
# ------------------------------------------------------------------------------
logs/
*.log
coverage/
.nyc_output/

# ------------------------------------------------------------------------------
# 7. HỆ ĐIỀU HÀNH (WINDOWS & UBUNTU / LINUX & MACOS)
# ------------------------------------------------------------------------------
# Ubuntu / Linux (Thành viên dùng Ubuntu)
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# Windows (Thành viên dùng Windows)
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS (Nếu có thành viên dùng Mac)
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# ------------------------------------------------------------------------------
# 8. MÔI TRƯỜNG PHÁT TRIỂN & IDE (IDE & EDITORS)
# ------------------------------------------------------------------------------
.idea/
*.sublime-project
*.sublime-workspace

# VS Code (Giữ lại cấu hình dùng chung settings, extensions nếu có)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# 9. KỶ LUẬT SCRATCHPAD (SCRATCH DIRECTORY DISCIPLINE)
# ------------------------------------------------------------------------------
# Bỏ qua các tệp script kiểm tra tạm thời, file rác và nhật ký động trong scratch/
scratch/*.ps1
scratch/*.sh
scratch/*.py
scratch/*.tmp
scratch/*.json
scratch/agent_observations.md
scratch/code_review_report.md

# BẢO TỒN CÁC TỆP MẪU CHUẨN & README TRONG SCRATCH
!scratch/README.md
!scratch/agent_observations.template.md
!scratch/code_review_report.template.md
