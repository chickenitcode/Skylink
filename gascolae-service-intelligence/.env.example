# ==============================================================================
# GASCOLAE SERVICE INTELLIGENCE - ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
DB_USER=gascolae_admin
DB_PASSWORD=gascolae_secret_2026
DB_NAME=gascolae_intelligence
DB_PORT=5432
DB_HOST=localhost

# Prisma Database URL
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_gascolae_2026
JWT_REFRESH_SECRET=super_secret_refresh_key_gascolae_2026
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------------------------------------------
# 4. AI PROVIDERS (LLM & EMBEDDING)
# ------------------------------------------------------------------------------
# Supported Providers: gemini, mock
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Mock Mode Configuration (MOCK MODE BẮT BUỘC)
USE_MOCK_LLM=true
USE_MOCK_EMBEDDING=true
USE_MOCK_API=false

# ------------------------------------------------------------------------------
# 5. STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=gascolae-assets
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Local storage paths for development
LOCAL_STORAGE_PATH=./storage
TEMP_DOC_PATH=./temp_docs
