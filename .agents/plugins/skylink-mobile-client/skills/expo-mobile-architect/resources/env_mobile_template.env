# ==============================================================================
# TỆP MẪU BIẾN MÔI TRƯỜNG DÀNH CHO ỨNG DỤNG DI ĐỘNG EXPO (REACT NATIVE)
# Đổi tên tệp thành .env và đặt tại thư mục gốc apps/mobile/
# ==============================================================================

# URL API Cổng kết nối Backend NestJS
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Thời gian chờ phản hồi tối đa (milliseconds)
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Đường dẫn API làm mới Access Token
EXPO_PUBLIC_AUTH_REFRESH_PATH=/auth/refresh

# Namespace lưu trữ trên SecureStore (chống đè dữ liệu)
EXPO_PUBLIC_TOKEN_NAMESPACE=skylink_dev

# Môi trường chạy ứng dụng (development | staging | production)
EXPO_PUBLIC_APP_ENV=development
